{
  "name": "@local/dsh-collapsible-answer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Keeps a complete, concise answer visible and folds optional detail under clickable headings.",
  "author": "JerryMazeyu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JerryMazeyu/dsh-collapsible-answer.git"
  },
  "homepage": "https://github.com/JerryMazeyu/dsh-collapsible-answer#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
